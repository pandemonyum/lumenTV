# Backend
LUMENTV_HOST=0.0.0.0
LUMENTV_PORT=8787
LUMENTV_DATABASE=./data/lumentv.sqlite
LUMENTV_IMAGE_DIR=./data/images
LUMENTV_SECRET=replace-with-at-least-32-random-characters
# Chiave precedente, solo per leggere dati cifrati prima di una rotazione di LUMENTV_SECRET.
LUMENTV_PREVIOUS_SECRET=

# In LAN sostituire localhost con l'IP del server, es. 192.168.1.50.
LUMENTV_PUBLIC_BASE_URL=http://localhost:8787
LUMENTV_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost,null

LUMENTV_PLAYLIST_MAX_BYTES=104857600
LUMENTV_IMAGE_MAX_BYTES=8388608

# Curatela home. Chiave gratuita su https://www.themoviedb.org/settings/api
# Senza chiave la home ripiega sulle categorie piu ricche della playlist.
LUMENTV_TMDB_API_KEY=
LUMENTV_TMDB_LANGUAGE=it-IT
LUMENTV_TMDB_REGION=IT
LUMENTV_TRENDING_TTL_HOURS=24
LUMENTV_HOME_ROW_LIMIT=6

# Imposta a true per escludere automaticamente i contenuti con tag espliciti durante l'importazione.
LUMENTV_SAFE_MODE=false

# Client. Per LG/iOS/Android usare un URL raggiungibile dal dispositivo.
VITE_API_BASE_URL=http://localhost:8787
VITE_APP_NAME=LumenTV
